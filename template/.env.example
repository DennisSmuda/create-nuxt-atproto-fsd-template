DATABASE_URL="file:./dev.db"
NUXT_AUTH_SECRET="generate-a-random-secret"
NUXT_AUTH_ORIGIN="http://127.0.0.1:3000/api/auth"
# 127.0.0.1 rather than localhost: AT Protocol's loopback redirect requires it.
APP_ORIGIN="http://127.0.0.1:3000"

# Email + password sign-in: a development affordance, on by default in `nuxt dev`
# and off in a production build. Set to "true" only where you want it back.
# NUXT_PUBLIC_PASSWORD_AUTH="true"

# Restrict new accounts to Bluesky handles and/or emails you already know.
# Comma-separated, case-insensitive, leading "@" optional. Unset or empty
# means anyone can sign up. Existing accounts can still log in either way.
# SIGNUP_ALLOWLIST="alice.bsky.social,bob@example.com"
