DATABASE_URL="file:./dev.db"
NUXT_AUTH_SECRET="generate-a-random-secret"
NUXT_AUTH_ORIGIN="http://127.0.0.1:3000/api/auth"
# 127.0.0.1 rather than localhost: AT Protocol's loopback redirect requires it.
APP_ORIGIN="http://127.0.0.1:3000"

# Restrict new accounts to Bluesky handles you already know. Comma-separated,
# case-insensitive, leading "@" optional. Unset or empty means anyone can
# sign up. Existing accounts can still log in.
# SIGNUP_ALLOWLIST="alice.bsky.social,bob.bsky.social"
